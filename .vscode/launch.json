            "cwd": "${workspaceRoot}",
            "sourceLanguages": [
                "rust"
            ]
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug (Fixture: stresstest - orchestral score)",
            "preLaunchTask": "rust: cargo build",
            "program": "${workspaceRoot}/target/debug/opus",
            "args": [
                "render",
                "svg",
                "--out", "assets/xmltest",
                "--file", "assets/xmlfixtures/stresstest.musicxml",
