{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug (Actor Prelude Sample)",
            "preLaunchTask": "rust: cargo build",
            "program": "${workspaceRoot}/target/debug/opus",
            "args": [
                "render",
                "svg",
                "--file", "assets/xmlsamples/ActorPreludeSample.musicxml",
                "--out", "assets/xmltest", "--overwrite",
                "--meta", "assets/smufl/bravura-bravura-1.392/redist/bravura_metadata.json",
                "--glyphs", "assets/smufl/metadata/glyphnames.json",
                "--debug",
                "--page-color", "#112233",
                "--foreground-color", "#d9d5cc"
            ],
            "cwd": "${workspaceRoot}",
            "sourceLanguages": [
                "rust"
            ]
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug (Brahms Sample)",
