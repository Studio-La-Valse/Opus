{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug (Actor Prelude Sample)",
            "preLaunchTask": "rust: cargo build",
            "program": "${workspaceRoot}/target/debug/app",
            "args": [
                "--file", "xmlsamples/ActorPreludeSample.musicxml", 
                "--out", "xmltest/test.svg",
                "--meta", "smufl/bravura-bravura-1.392/redist/bravura_metadata.json",
                "--glyphs", "smufl/metadata/glyphnames.json",
                "--debug",
                "--page-color", "#112233",
                "--foreground-color", "#d9d5cc"
            ],
            "cwd": "${workspaceRoot}",
            "sourceLanguages": [
                "rust"
            ]
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug (Brahms Sample)",
            "preLaunchTask": "rust: cargo build",
            "program": "${workspaceRoot}/target/debug/app",
            "args": [
                "--file", "xmlsamples/BrahWiMeSample.musicxml",
                "--out", "xmltest/test.svg",
                "--meta", "smufl/bravura-bravura-1.392/redist/bravura_metadata.json",
                "--glyphs", "smufl/metadata/glyphnames.json",
                //"--debug",
                //"--page-color", "#112233",
                //"--foreground-color", "#44556677"
            ],
            "cwd": "${workspaceRoot}",
            "sourceLanguages": [
                "rust"
            ]
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug (Vertical Orientation Sample)",
            "preLaunchTask": "rust: cargo build",
            "program": "${workspaceRoot}/target/debug/app",
            "args": [
                "--file", "xmlsamples/ActorPreludeSample.musicxml",
                "--out", "xmltest/test.svg",
                "--meta", "smufl/bravura-bravura-1.392/redist/bravura_metadata.json",
                "--glyphs", "smufl/metadata/glyphnames.json",
                "--page-orientation", "vertical",
                "--vertical-gutter", "10",
                "--debug"
            ],
            "cwd": "${workspaceRoot}",
            "sourceLanguages": [
                "rust"
            ]
        }
    ]
}