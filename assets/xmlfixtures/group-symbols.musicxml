<?xml version="1.0" encoding="UTF-8"?>
<!--
  Every <group-symbol> value the format defines, at both levels that can carry
  one, over a deliberately uneven structure. Nothing here is a realistic score;
  it exists so that one render shows all five shapes at once and so that the
  cases which decide whether a symbol is drawn at all are each present.

  section 0  bracket
    group 0  square   P1 P2 P3          three parts
    group 1  brace    P4 P5             two parts
             P6                         a part sitting directly in the section,
                                        which the builder gives a part-group of
                                        its own. One part, so no symbol
  section 1  line
    group 0  none     P7 P8 P9 P10      four parts, and an explicit "none":
                                        the group is real, its symbol draws
                                        nothing
    group 1  square   P11 P12           P12 has two staves, so it draws a part
                                        symbol of its own inside the group's
  section 2  square
    group 0  brace    P13 P14           three staves and two: two nested part
                                        symbols under one group symbol
    group 1  line     P15 P16           two staves and one, so the group spans
                                        an uneven pair
  P17                                   top level, enclosed by nothing at all.
                                        It gets a section index with no
                                        <part-group> behind it to have declared
                                        anything

  A section draws its symbol only when it holds more than one part-group, and a
  part-group only when it holds more than one part and more than one visible
  staff, which is why the single-part levels above are here: they are the cases
  that must stay blank.
-->
<score-partwise version="4.0">
  <part-list>
    <part-group type="start"><group-symbol>bracket</group-symbol></part-group>
    <part-group type="start"><group-name>Flutes</group-name><group-symbol>square</group-symbol></part-group>
    <score-part id="P1"><part-name>Flute 1</part-name><part-abbreviation>Fl. 1</part-abbreviation></score-part>
    <score-part id="P2"><part-name>Flute 2</part-name><part-abbreviation>Fl. 2</part-abbreviation></score-part>
    <score-part id="P3"><part-name>Piccolo</part-name><part-abbreviation>Picc.</part-abbreviation></score-part>
    <part-group type="stop"/>
    <part-group type="start"><group-name>Clarinets</group-name><group-symbol>brace</group-symbol></part-group>
    <score-part id="P4"><part-name>Clarinet 1</part-name><part-abbreviation>Cl. 1</part-abbreviation></score-part>
    <score-part id="P5"><part-name>Clarinet 2</part-name><part-abbreviation>Cl. 2</part-abbreviation></score-part>
    <part-group type="stop"/>
    <score-part id="P6"><part-name>Bassoon</part-name><part-abbreviation>Bsn.</part-abbreviation></score-part>
    <part-group type="stop"/>
    <part-group type="start"><group-symbol>line</group-symbol></part-group>
    <part-group type="start"><group-name>Horns</group-name><group-symbol>none</group-symbol></part-group>
    <score-part id="P7"><part-name>Horn 1</part-name><part-abbreviation>Hn. 1</part-abbreviation></score-part>
    <score-part id="P8"><part-name>Horn 2</part-name><part-abbreviation>Hn. 2</part-abbreviation></score-part>
    <score-part id="P9"><part-name>Horn 3</part-name><part-abbreviation>Hn. 3</part-abbreviation></score-part>
    <score-part id="P10"><part-name>Horn 4</part-name><part-abbreviation>Hn. 4</part-abbreviation></score-part>
    <part-group type="stop"/>
    <part-group type="start"><group-symbol>square</group-symbol></part-group>
    <score-part id="P11"><part-name>Trumpet</part-name><part-abbreviation>Tpt.</part-abbreviation></score-part>
    <score-part id="P12"><part-name>Trombone</part-name><part-abbreviation>Tbn.</part-abbreviation></score-part>
    <part-group type="stop"/>
    <part-group type="stop"/>
    <part-group type="start"><group-symbol>square</group-symbol></part-group>
    <part-group type="start"><group-name>Keyboards</group-name><group-symbol>brace</group-symbol></part-group>
    <score-part id="P13"><part-name>Organ</part-name><part-abbreviation>Org.</part-abbreviation></score-part>
    <score-part id="P14"><part-name>Celesta</part-name><part-abbreviation>Cel.</part-abbreviation></score-part>
    <part-group type="stop"/>
    <part-group type="start"><group-symbol>line</group-symbol></part-group>
    <score-part id="P15"><part-name>Harp</part-name><part-abbreviation>Hp.</part-abbreviation></score-part>
    <score-part id="P16"><part-name>Timpani</part-name><part-abbreviation>Timp.</part-abbreviation></score-part>
    <part-group type="stop"/>
    <part-group type="stop"/>
    <score-part id="P17"><part-name>Solo Violin</part-name><part-abbreviation>Vln.</part-abbreviation></score-part>
  </part-list>
