<?xml version="1.0" encoding="UTF-8"?>
<score-partwise version="4.0">
  <!--
    A beam group whose secondary level is opened and never closed.

    Every note declares as many <beam> elements as its duration warrants, so
    the rebeam pass sees nothing wrong and leaves the group alone; it is the
    beam *types* that are inconsistent, not their count. Level 2 runs
    begin / continue / continue and no note ever ends it.

    Measure 2 is the same defect one level up: level 1 itself is never closed.
  -->
  <part-list>
    <score-part id="P1"><part-name>Unclosed beams</part-name></score-part>
  </part-list>
  <part id="P1">
    <measure number="1" width="300">
      <print new-system="yes"/>
      <attributes>
        <divisions>4</divisions>
        <key><fifths>0</fifths><mode>major</mode></key>
        <time><beats>4</beats><beat-type>4</beat-type></time>
        <clef><sign>G</sign><line>2</line></clef>
      </attributes>
      <note default-x="80">
        <pitch><step>C</step><octave>5</octave></pitch><duration>1</duration><voice>1</voice>
        <type>16th</type><stem>down</stem>
        <beam number="1">begin</beam><beam number="2">begin</beam>
      </note>
      <note default-x="110">
        <pitch><step>D</step><octave>5</octave></pitch><duration>1</duration><voice>1</voice>
        <type>16th</type><stem>down</stem>
        <beam number="1">continue</beam><beam number="2">continue</beam>
      </note>
      <note default-x="140">
        <pitch><step>E</step><octave>5</octave></pitch><duration>1</duration><voice>1</voice>
        <type>16th</type><stem>down</stem>
        <beam number="1">end</beam><beam number="2">continue</beam>
      </note>
    </measure>
    <measure number="2" width="300">
      <note default-x="80">
        <pitch><step>C</step><octave>5</octave></pitch><duration>2</duration><voice>1</voice>
        <type>eighth</type><stem>down</stem>
        <beam number="1">begin</beam>
      </note>
      <note default-x="120">
        <pitch><step>D</step><octave>5</octave></pitch><duration>2</duration><voice>1</voice>
        <type>eighth</type><stem>down</stem>
        <beam number="1">continue</beam>
      </note>
    </measure>
  </part>
</score-partwise>
